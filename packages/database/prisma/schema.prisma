}

model Contract {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @db.Uuid @map("created_by")
  updatedBy String? @db.Uuid @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name String
  contractNumber String
  startDate DateTime
  endDate DateTime
  value Decimal @db.Decimal(14,2)
  services String
  renewalStatus String @default("ACTIVE")
  businessUnitId String @db.Uuid
  businessUnit BusinessUnit @relation("Contract_businessUnit", fields: [businessUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  clientId String @db.Uuid
  client Client @relation("Contract_client", fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  site_contract Site[] @relation("Site_contract")
  invoice_contract Invoice[] @relation("Invoice_contract")
  document_contract Document[] @relation("Document_contract")
  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, businessUnitId])
  @@unique([organizationId, contractNumber])
  @@map("contracts")
}

model Site {
  challanRecords Challan[]
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @db.Uuid @map("created_by")
  updatedBy String? @db.Uuid @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name String
  address String
  latitude Float?
  longitude Float?
  wasteType String @default("MIXED")
  expectedDailyWaste Decimal @default(0) @db.Decimal(12,3)
  startDate DateTime @default(now())
  status String @default("ACTIVE")
  businessUnitId String @db.Uuid
  businessUnit BusinessUnit @relation("Site_businessUnit", fields: [businessUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  clientId String @db.Uuid
  client Client @relation("Site_client", fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  contractId String? @db.Uuid
  contract Contract? @relation("Site_contract", fields: [contractId, organizationId], references: [id, organizationId], onDelete: Restrict)
  managerId String? @db.Uuid
  manager Employee? @relation("Site_manager", fields: [managerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supervisorId String? @db.Uuid
  supervisor Employee? @relation("Site_supervisor", fields: [supervisorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  siteAssignment_site SiteAssignment[] @relation("SiteAssignment_site")
  attendanceDevice_site AttendanceDevice[] @relation("AttendanceDevice_site")
  attendance_site Attendance[] @relation("Attendance_site")
  wasteRecord_site WasteRecord[] @relation("WasteRecord_site")
  disposal_site Disposal[] @relation("Disposal_site")
  task_site Task[] @relation("Task_site")
  ticket_site Ticket[] @relation("Ticket_site")
  siteVisit_site SiteVisit[] @relation("SiteVisit_site")
  machine_site Machine[] @relation("Machine_site")
  machineEvent_site MachineEvent[] @relation("MachineEvent_site")
  productionBatch_site ProductionBatch[] @relation("ProductionBatch_site")
  maintenanceRecord_site MaintenanceRecord[] @relation("MaintenanceRecord_site")
  invoice_site Invoice[] @relation("Invoice_site")
  payment_site Payment[] @relation("Payment_site")
  expense_site Expense[] @relation("Expense_site")
  document_site Document[] @relation("Document_site")
  notification_site Notification[] @relation("Notification_site")
  auditLog_site AuditLog[] @relation("AuditLog_site")
  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, businessUnitId])
  @@map("sites")
}

