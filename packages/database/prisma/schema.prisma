generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @db.Uuid @map("created_by")
  updatedBy String? @db.Uuid @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  name String
  slug String @unique
  profiles PersonProfile[]
  businessUnitRecords BusinessUnit[]
  roleRecords Role[]
  rolePermissionRecords RolePermission[]
  userRecords User[]
  sessionRecords Session[]
  departmentRecords Department[]
  employeeRecords Employee[]
  clientRecords Client[]
  contactRecords Contact[]
  leadRecords Lead[]
  followUpRecords FollowUp[]
  contractRecords Contract[]
  siteRecords Site[]
  shiftRecords Shift[]
  siteAssignmentRecords SiteAssignment[]
  nfcCardRecords NfcCard[]
  attendanceDeviceRecords AttendanceDevice[]
  attendanceRecords Attendance[]
  attendanceTapRecords AttendanceTap[]
  wasteCategoryRecords WasteCategory[]
  wasteRecordRecords WasteRecord[]
  vendorRecords Vendor[]
  vehicleRecords Vehicle[]
  disposalRecords Disposal[]
  taskRecords Task[]
  ticketRecords Ticket[]
  siteVisitRecords SiteVisit[]
  machineRecords Machine[]
  machineEventRecords MachineEvent[]
  productionBatchRecords ProductionBatch[]
  maintenanceRecordRecords MaintenanceRecord[]
  sparePartRecords SparePart[]
  invoiceRecords Invoice[]
  challanRecords Challan[]
  savedPdfRecords SavedPdf[]
  paymentRecords Payment[]
  expenseRecords Expense[]
  documentRecords Document[]
  notificationRecords Notification[]
  auditLogRecords AuditLog[]
  @@map("organizations")
}

model BusinessUnit {
  challanRecords Challan[]
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @db.Uuid @map("created_by")
  updatedBy String? @db.Uuid @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name String
  code String
  user_businessUnit User[] @relation("User_businessUnit")
  department_businessUnit Department[] @relation("Department_businessUnit")
  employee_businessUnit Employee[] @relation("Employee_businessUnit")
  client_businessUnit Client[] @relation("Client_businessUnit")
  lead_businessUnit Lead[] @relation("Lead_businessUnit")
  contract_businessUnit Contract[] @relation("Contract_businessUnit")
  site_businessUnit Site[] @relation("Site_businessUnit")
  shift_businessUnit Shift[] @relation("Shift_businessUnit")
  siteAssignment_businessUnit SiteAssignment[] @relation("SiteAssignment_businessUnit")
  attendanceDevice_businessUnit AttendanceDevice[] @relation("AttendanceDevice_businessUnit")
  attendance_businessUnit Attendance[] @relation("Attendance_businessUnit")
  wasteRecord_businessUnit WasteRecord[] @relation("WasteRecord_businessUnit")
  vendor_businessUnit Vendor[] @relation("Vendor_businessUnit")
  vehicle_businessUnit Vehicle[] @relation("Vehicle_businessUnit")
  disposal_businessUnit Disposal[] @relation("Disposal_businessUnit")
  task_businessUnit Task[] @relation("Task_businessUnit")
  ticket_businessUnit Ticket[] @relation("Ticket_businessUnit")
  siteVisit_businessUnit SiteVisit[] @relation("SiteVisit_businessUnit")
  machine_businessUnit Machine[] @relation("Machine_businessUnit")
  machineEvent_businessUnit MachineEvent[] @relation("MachineEvent_businessUnit")
  productionBatch_businessUnit ProductionBatch[] @relation("ProductionBatch_businessUnit")
  maintenanceRecord_businessUnit MaintenanceRecord[] @relation("MaintenanceRecord_businessUnit")
  invoice_businessUnit Invoice[] @relation("Invoice_businessUnit")
  payment_businessUnit Payment[] @relation("Payment_businessUnit")
  expense_businessUnit Expense[] @relation("Expense_businessUnit")
  document_businessUnit Document[] @relation("Document_businessUnit")
  notification_businessUnit Notification[] @relation("Notification_businessUnit")
  auditLog_businessUnit AuditLog[] @relation("AuditLog_businessUnit")
  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
  @@unique([organizationId, code])
  @@map("business_units")
}

model Role {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @db.Uuid @map("created_by")
  updatedBy String? @db.Uuid @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name String
  scope String @default("ASSIGNED")
  rolePermission_role RolePermission[] @relation("RolePermission_role")
  user_role User[] @relation("User_role")
  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @db.Uuid @map("created_by")
  updatedBy String? @db.Uuid @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  key String @unique
  description String
  rolePermission_permission RolePermission[] @relation("RolePermission_permission")
  @@map("permissions")
}

model RolePermission {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @db.Uuid @map("created_by")
  updatedBy String? @db.Uuid @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roleId String @db.Uuid
  role Role @relation("RolePermission_role", fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  permissionId String @db.Uuid
  permission Permission @relation("RolePermission_permission", fields: [permissionId], references: [id], onDelete: Restrict)
  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @db.Uuid @map("created_by")
  updatedBy String? @db.Uuid @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clientId String? @db.Uuid
  client Client? @relation("User_client", fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  email String @unique
  name String
  passwordHash String
  status String @default("ACTIVE")
  roleId String @db.Uuid
  role Role @relation("User_role", fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  businessUnitId String? @db.Uuid
  businessUnit BusinessUnit? @relation("User_businessUnit", fields: [businessUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  session_user Session[] @relation("Session_user")
  employee_user Employee[] @relation("Employee_user")
  notification_user Notification[] @relation("Notification_user")
  auditLog_actor AuditLog[] @relation("AuditLog_actor")
  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, businessUnitId])
  @@map("users")
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @db.Uuid @map("created_by")
  updatedBy String? @db.Uuid @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tokenHash String @unique
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  userId String @db.Uuid
  user User @relation("Session_user", fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
  @@map("sessions")
}

model Department {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @db.Uuid @map("created_by")
  updatedBy String? @db.Uuid @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name String
  businessUnitId String? @db.Uuid
  businessUnit BusinessUnit? @relation("Department_businessUnit", fields: [businessUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  employee_department Employee[] @relation("Employee_department")
  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, businessUnitId])
  @@map("departments")
}

model Employee {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @db.Uuid @map("created_by")
  updatedBy String? @db.Uuid @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  organizationId String @db.Uuid @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeCode String
  name String
  phone String?
  email String?
  position String @default("WORKER")
  joiningDate DateTime @default(now())
  status String @default("ACTIVE")
  businessUnitId String @db.Uuid
  businessUnit BusinessUnit @relation("Employee_businessUnit", fields: [businessUnitId, organizationId], references: [id, organizationId], onDelete: Restrict)
  userId String? @db.Uuid
  user User? @relation("Employee_user", fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)
  departmentId String? @db.Uuid
  department Department? @relation("Employee_department", fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supervisorId String? @db.Uuid
  supervisor Employee? @relation("Employee_supervisor", fields: [supervisorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  managerId String? @db.Uuid
  manager Employee? @relation("Employee_manager", fields: [managerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  employee_supervisor Employee[] @relation("Employee_supervisor")
  employee_manager Employee[] @relation("Employee_manager")
  client_manager Client[] @relation("Client_manager")
  lead_salesperson Lead[] @relation("Lead_salesperson")
  site_manager Site[] @relation("Site_manager")
  site_supervisor Site[] @relation("Site_supervisor")
  siteAssignment_employee SiteAssignment[] @relation("SiteAssignment_employee")
  siteAssignment_supervisor SiteAssignment[] @relation("SiteAssignment_supervisor")
  nfcCard_employee NfcCard[] @relation("NfcCard_employee")
  attendance_employee Attendance[] @relation("Attendance_employee")
  attendanceTap_employee AttendanceTap[] @relation("AttendanceTap_employee")
  wasteRecord_worker WasteRecord[] @relation("WasteRecord_worker")
  task_assignee Task[] @relation("Task_assignee")
  ticket_assignee Ticket[] @relation("Ticket_assignee")
  siteVisit_manager SiteVisit[] @relation("SiteVisit_manager")
  productionBatch_operator ProductionBatch[] @relation("ProductionBatch_operator")
  maintenanceRecord_technician MaintenanceRecord[] @relation("MaintenanceRecord_technician")
  document_employee Document[] @relation("Document_employee")
  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, businessUnitId])
  @@unique([organizationId, employeeCode])
  @@unique([userId, organizationId])
  @@map("employees")
}

