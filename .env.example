NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/useless_os?schema=public
DIRECT_URL=postgresql://postgres:change-me@localhost:5432/useless_os?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Explicitly set these before running the DEVELOPMENT-ONLY seed.
SEED_ADMIN_EMAIL=admin@useless.example
SEED_ADMIN_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=operations-documents

# Optional development role accounts (14+ characters, maximum 72 UTF-8 bytes)
SEED_SUPERVISOR_EMAIL=supervisor@example.com
SEED_SUPERVISOR_PASSWORD=
# After changing credentials in .env, run: npm run db:seed:passwords
# This updates existing seeded logins without regenerating demo records.
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=
SEED_ACCOUNTANT_EMAIL=accountant@example.com
SEED_ACCOUNTANT_PASSWORD=
